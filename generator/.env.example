# PLANTILLA versionada. Copiar a generator/.env y completar ahí.
# NO escribas claves reales en este archivo: este sí se sube al repo; .env no.

# --- OpenAI (paso 1: limpieza de la foto de producto) ---
OPENAI_API_KEY=sk-...
# gpt-image-2 (insignia, abr-2026) | gpt-image-1.5 | gpt-image-1-mini (barato)
OPENAI_IMAGE_MODEL=gpt-image-2
# low (~US$0.006/img) | medium (~US$0.053) | high (~US$0.211)
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024

# --- Meshy (paso 3: imagen -> malla texturizada) ---
MESHY_API_KEY=msy_...
# meshy-6 | meshy-5 | latest
MESHY_AI_MODEL=meshy-6
MESHY_TEXTURE_RES=2k
MESHY_POLYCOUNT=30000

# --- Blender (paso 5, opcional) ---
BLENDER_EXE=C:\Program Files\Blender Foundation\Blender 5.1\blender.exe
