# Variables del servicio de generación.
# En Railway se cargan en Variables -> RAW Editor; este archivo es la referencia.
# NO se versiona ningún valor real.

# --- Obligatorias ---
# La misma cadena que AUREO_PRO_GEN_SERVICE_KEY en el wp-config.php del sitio.
# Generar con:  python -c "import secrets;print(secrets.token_hex(32))"
AUREO_SHARED_KEY=

# Pasos 0 y 1: identificar el producto en la foto y limpiarla.
OPENAI_API_KEY=

# Paso 3: reconstrucción de la malla.
MESHY_API_KEY=

# --- Almacenamiento (apuntar al volumen montado en /data) ---
# Sin esto el disco es efímero y un redespliegue borra trabajos ya pagados.
GEN3D_JOBS_DIR=/data/jobs
GEN3D_PRUEBAS_DIR=/data/pruebas

# --- Opcionales ---
# low ~US$0.006 por imagen · medium ~US$0.05 · high ~US$0.21
OPENAI_IMAGE_QUALITY=medium
# Solo si el dominio no es el que genera Railway.
# PUBLIC_URL=https://algo.up.railway.app
