# Variables del servicio de generación.
# En la VPS van en el .env que lea el proceso del servicio al arrancar. Este
# archivo es solo la referencia: NO se versiona ningún valor real, y .env
# tampoco se commitea.
#
# Copiar:  cp service/.env.example service/.env   — y completar.

# --- Obligatorias ---
# La misma cadena que AUREO_PRO_GEN_SERVICE_KEY en el wp-config.php del sitio.
# Generar con:  python -c "import secrets;print(secrets.token_hex(32))"
AUREO_SHARED_KEY=

# Pasos 0 y 1: identificar el producto en la foto y limpiarla.
OPENAI_API_KEY=

# Paso 3: reconstrucción de la malla.
MESHY_API_KEY=

# --- Almacenamiento (apuntar a un disco persistente, fuera de /opt/ar-shoes) ---
# Si un redespliegue hace "git pull" sobre /opt/ar-shoes, estas carpetas deben
# quedar afuera de ese árbol para no perder trabajos ya pagados.
GEN3D_JOBS_DIR=/data/jobs
GEN3D_PRUEBAS_DIR=/data/pruebas

# --- Obligatoria en la VPS ---
# El dominio HTTPS público del servicio (el proxy/reverse-proxy que se monte
# en la VPS le tiene que apuntar al mismo puerto que PORT, abajo). Sin esto,
# las URLs de archivos y el callback a WordPress se arman con 127.0.0.1 y
# quedan inválidas afuera del propio servidor.
PUBLIC_URL=https://TU-DOMINIO-AQUI

# --- Opcionales ---
# low ~US$0.006 por imagen · medium ~US$0.05 · high ~US$0.21
OPENAI_IMAGE_QUALITY=medium
# Puerto donde escucha el servicio.
PORT=8080
